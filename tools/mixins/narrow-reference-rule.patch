+        /// Whether a node with these attributes stays: it does unless a `cfg` turns it off. The
+        /// attributes are rewritten on the way.
+        fn keep(&self, attrs: &mut Vec<Attribute>, features: bool) -> bool {
+            self.apply_attrs(attrs, features) != Truth::No
+        }
+    }
+
+    /// The cfg names that follow from the validated target, taken from the printed set and
+    /// compared on their full values.
+    const TARGET_FACTS: [&str; 10] = [
+        "target_os",
+        "target_family",
+        "unix",
+        "windows",
+        "target_arch",
+        "target_pointer_width",
+        "target_endian",
+        "target_env",
+        "target_vendor",
+        "target_abi",
+    ];
+
+    /// `name` or `name="value"` as the one string the set holds; `None` for any other shape.
+    fn option_key(meta: &Meta) -> Option<String> {
+        match meta {
+            Meta::Path(path) => path.get_ident().map(|i| i.unraw().to_string()),
+            Meta::NameValue(nv) => {
+                let name = nv.path.get_ident()?.unraw();
+                match &nv.value {
+                    Expr::Lit(lit) => match &lit.lit {
+                        Lit::Str(value) => Some(format!("{name}={:?}", value.value())),
+                        _ => None,
+                    },
+                    _ => None,
+                }
+            }
+            Meta::List(_) => None,
+        }
