+        /// Applies the `cfg` and `cfg_attr` attributes in `attrs`: whether the node they sit on is
+        /// compiled (`Yes`, with the attributes rewritten), is not (`No`), or cannot be told
+        /// (`Unknown`, the undecided attributes kept).
+        fn apply_attrs(&self, attrs: &mut Vec<Attribute>, features: bool) -> Truth {
+            let mut result = Truth::Yes;
+            let mut out = Vec::with_capacity(attrs.len());
+            let mut pending: Vec<Attribute> = std::mem::take(attrs);
+            pending.reverse();
+            while let Some(attr) = pending.pop() {
+                if attr.path().is_ident("cfg") {
+                    match attr.parse_args::<Meta>().map(|m| self.eval(&m, features)) {
+                        Ok(Truth::Yes) => {}
