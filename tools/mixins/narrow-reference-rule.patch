+/// Whether a helper's return type is the cancellation contract's `ControlFlow<Output>`, which may
+/// be written `ControlFlow`, `core::ops::ControlFlow`, `::core::ops::ControlFlow` or the same
+/// through `std`. Only the outermost path takes these spellings; its arguments compare as types.
+fn same_cancellation_type(helper: &Type, contract: &Type) -> bool {
+    fn control_flow(ty: &Type) -> Option<&syn::PathSegment> {
+        let Type::Path(path) = ty else { return None };
+        if path.qself.is_some() {
+            return None;
+        }
+        let names: Vec<_> = path
+            .path
+            .segments
+            .iter()
+            .map(|s| s.ident.to_string())
+            .collect();
+        let names: Vec<_> = names.iter().map(String::as_str).collect();
+        // Only the last segment takes arguments, and a bare name is relative: `::ControlFlow`
+        // names a crate.
+        let prefixes_plain = path
+            .path
+            .segments
+            .iter()
+            .rev()
+            .skip(1)
+            .all(|s| s.arguments.is_none());
+        match names.as_slice() {
+            ["ControlFlow"] if path.path.leading_colon.is_none() => path.path.segments.last(),
+            ["core" | "std", "ops", "ControlFlow"] if prefixes_plain => path.path.segments.last(),
+            _ => None,
+        }
+    }
+    match (control_flow(helper), control_flow(contract)) {
+        (Some(a), Some(b)) => {
+            normalize_type_arguments(&a.arguments) == normalize_type_arguments(&b.arguments)
+        }
+        _ => normalize_type(helper) == normalize_type(contract),
+    }
+}
+fn normalize_type_arguments(arguments: &syn::PathArguments) -> String {
+    let mut ty: Type = syn::parse_quote!(Probe);
+    let Type::Path(path) = &mut ty else {
+        unreachable!()
+    };
+    path.path.segments[0].arguments = arguments.clone();
+    normalize_type(&ty)
