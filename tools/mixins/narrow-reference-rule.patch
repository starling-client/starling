+/// The fingerprint an OVERWRITE row pins for the function `target` of the workspace at `root`.
+fn pin(root: &std::path::Path, target: &str) -> String {
+    let index = Index::load(root).unwrap();
+    let f = index.resolve(target).unwrap();
+    source::fingerprint(format!(
+        "{}{}",
+        horizon_mixins_core::index::tokens(&f.signature),
+        horizon_mixins_core::index::tokens(&f.block)
+    ))
+}
+
+/// Adds a mod `gamma` with one injection `second` (`row`, with `helper_source` as its helper).
+fn add_mod(f: &Fixture, row: &str, helper_source: &str) {
+    fs::create_dir_all(f.mods.join("gamma")).unwrap();
+    fs::write(
+        f.mods.join("gamma/horizon-mixin.toml"),
+        format!("[mod]\nid = \"gamma\"\nversion = \"0.1.0\"\n\n[[injection]]\nid = \"second\"\n{row}\nhelper = \"second.rs\"\n"),
+    )
+    .unwrap();
+    fs::write(f.mods.join("gamma/second.rs"), helper_source).unwrap();
+}
