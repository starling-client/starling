//! Per-library entry module generated by the launcher.
extern crate mod_api;

macro_rules! native_mods {
    ($($id:literal => $hooks:path,)*) => {
        vec![$(mod_api::ModEntry::new($id, $hooks()),)*]
    };
}

#[inline(never)]
pub fn entries() -> Vec<mod_api::ModEntry> {
    /* MOD_LOGGERS */
    native_mods! {
    /* MOD_ENTRIES */
    }
}

fn installs() -> Vec<(&'static str, &'static [&'static str], bool)> {
    vec![
    /* MOD_REDIRECTS */
        ]
}
static BUILT: &[mod_api::__private::native::BuiltMod] = &[
/* BUILT_MODS */
];
#[unsafe(no_mangle)]
pub extern "C" fn sunrise_native_build() -> *const std::os::raw::c_char {
    // The build identity ends with the panic strategy this library was compiled with: the game
    // unwinds a refused Host call through the mod's frames, so it refuses `abort` at load. The
    // whole identity is one NUL-terminated literal, so the loader finds it in the library's
    // bytes before any of its code runs.
    #[cfg(panic = "unwind")]
    const IDENTITY: &std::ffi::CStr = c"/* NATIVE_BUILD */ unwind";
    #[cfg(not(panic = "unwind"))]
    const IDENTITY: &std::ffi::CStr = c"/* NATIVE_BUILD */ abort";
    IDENTITY.as_ptr()
}
#[unsafe(no_mangle)]
pub fn sunrise_native_mod_v1() -> &'static mod_api::__private::native::NativeMod {
    static MOD: std::sync::OnceLock<mod_api::__private::native::NativeMod> =
        std::sync::OnceLock::new();
    MOD.get_or_init(|| mod_api::__private::native::NativeMod {
        entries,
        built: BUILT,
        installs,
    })
}
