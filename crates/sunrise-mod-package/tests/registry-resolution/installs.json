      "side": "client",
      "native_fits": {},
      "expected": {"requested": {"butterflies": {"status": "installable", "version": "0.1.0"}}, "install": [{"id": "butterflies", "version": "0.1.0"}], "kept_unindexed": [{"id": "creature", "version": "0.1.9"}], "required_by": {"creature": ["butterflies"]}},
      "refusals": {}
